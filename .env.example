# Used by docker-compose.yml (copy to .env). Never commit the real file.

# Required: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=
# Required. Use letters and digits only: the value is embedded into DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=planner
POSTGRES_USER=planner

# Public address of the application (scheme + host + port); used for CSRF origin checks.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
# Hosts Django answers to (the Host header). Add your domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Set to true as soon as the site is served over HTTPS.
DJANGO_COOKIE_SECURE=false
# Number of gunicorn workers.
WEB_CONCURRENCY=3
